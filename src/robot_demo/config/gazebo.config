<?xml version="1.0"?>
<dialog name="quick_start" show_again="false"/>
<window><width>800</width><height>850</height><menus><drawer visible="false"/><plugins visible="false"/></menus><dialog_on_exit>false</dialog_on_exit></window>
<plugin filename="MinimalScene" name="3D View"><ignition-gui><title>Gazebo - GPS navigation</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui><engine>ogre2</engine><scene>scene</scene><ambient_light>0.7 0.7 0.7</ambient_light><background_color>0.12 0.15 0.20</background_color><camera_pose>4 -4.5 7 0 1.0 1.5708</camera_pose></plugin>
<plugin filename="GzSceneManager" name="Scene Manager"><ignition-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property><property key="state" type="string">floating</property></ignition-gui></plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control"><ignition-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property><property key="state" type="string">floating</property></ignition-gui></plugin>
