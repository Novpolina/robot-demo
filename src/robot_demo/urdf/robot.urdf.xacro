<?xml version="1.0"?>
<robot name="demo_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="blue"><color rgba="0.08 0.35 0.85 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.10 1"/></material>
  <material name="orange"><color rgba="1 0.55 0.08 1"/></material>
  <link name="base_link">
    <inertial><mass value="5"/><inertia ixx="0.08" iyy="0.10" izz="0.12" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.02"/><geometry><box size="0.42 0.32 0.16"/></geometry><material name="blue"/></visual>
    <collision name="body_collision"><origin xyz="0 0 0.02"/><geometry><box size="0.42 0.32 0.16"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <inertial><mass value="0.3"/><inertia ixx="0.001" iyy="0.0015" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry><material name="black"/></visual>
      <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel"/>
      <origin xyz="0 ${y} -0.03"/><axis xyz="0 1 0"/><limit effort="20" velocity="20"/><dynamics damping="0.05"/></joint>
    <gazebo reference="${side}_wheel"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="0.19"/><xacro:wheel side="right" y="-0.19"/>
  <!-- Front and rear low-friction supports keep the sensor platform level. -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <inertial><mass value="0.1"/><inertia ixx="0.00004" iyy="0.00004" izz="0.00004" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><geometry><sphere radius="0.04"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="0.04"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 -0.09"/></joint>
    <gazebo reference="${name}"><mu1>0.001</mu1><mu2>0.001</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="rear_caster" x="-0.16"/>
  <xacro:caster name="front_caster" x="0.16"/>
  <link name="lidar_link"><visual><geometry><cylinder radius="0.045" length="0.04"/></geometry><material name="orange"/></visual></link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.25"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.035 0.10 0.035"/></geometry><material name="black"/></visual></link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.24 0 0.19"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="-1.57079632679 0 -1.57079632679"/></joint>
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed"><parent link="base_link"/><child link="gps_link"/><origin xyz="0 0 0.12"/></joint>
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0.25 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><always_on>true</always_on>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan>
        <range><min>0.08</min><max>10</max><resolution>0.01</resolution></range></lidar>
    </sensor>
    <sensor name="astra_depth" type="rgbd_camera">
      <pose>0.24 0 0.19 0 0 0</pose><topic>/camera</topic><update_rate>10</update_rate><always_on>true</always_on>
      <camera><horizontal_fov>1.2</horizontal_fov><image><width>160</width><height>120</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>8</far></clip><depth_camera><clip><near>0.1</near><far>8</far></clip></depth_camera></camera>
    </sensor>
    <sensor name="gps" type="navsat"><pose>0 0 0.12 0 0 0</pose><topic>/gps/fix</topic><update_rate>10</update_rate><always_on>true</always_on></sensor>
    <sensor name="body_contact" type="contact"><topic>/contacts</topic><update_rate>50</update_rate><always_on>true</always_on>
      <contact><collision>base_link_fixed_joint_lump__body_collision_collision</collision></contact></sensor>
  </gazebo>
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.38</wheel_separation><wheel_radius>0.10</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/odom_tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher"><topic>/joint_states</topic></plugin>
  </gazebo>
</robot>
